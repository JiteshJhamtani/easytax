includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/

    # Level 9 is the highest level, but we start with 0 or 1 for legacy codebases
    # Let's use level 2 to catch undefined variables, unknown methods, and PHPDoc issues
    level: 2

    ignoreErrors:
        - '#Unsafe usage of new static\(\).#'
        - '#Call to an undefined static method#'
